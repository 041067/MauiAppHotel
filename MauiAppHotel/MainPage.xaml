<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppHotel.MainPage">

    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="20"
            VerticalOptions="Center">

            <Label
                Text="MauiAppHotel"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Hotel &amp; Hospedagem"
                FontSize="18"
                HorizontalOptions="Center" />

            <Button
                Text="🌤️ Consultar clima"
                Clicked="OnConsultarClimaClicked" />

            <Label
                x:Name="lblClima"
                Text="Clique no botão para consultar a API."
                FontSize="20"
                HorizontalTextAlignment="Center"
                Margin="0,10,0,0" />

            <Button
                Text="🏨 Fazer uma hospedagem"
                Clicked="OnContratarHospedagemClicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>