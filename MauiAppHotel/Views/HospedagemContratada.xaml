<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">
    <VerticalStackLayout VerticalOptions="CenterAndExpand">
        <Label Text="{Binding QuartoSelecionado.Descricao}" 
               TextColor="{StaticResource Primary}"
               FontFamily="KalamRegular"
               FontSize="50"
               HorizontalTextAlignment="Center"/>

        <Frame Padding="10">
            <VerticalStackLayout>
                <Frame Margin="10" BackgroundColor="{StaticResource PrimaryDark}">
                    <StackLayout Orientation="Horizontal">
                        <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                            <Label Text="Adultos:" />
                            <Label Text="{Binding QtdAdultos}" TextColor="{StaticResource Primary}" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                            <Label Text="Crianças:" />
                            <Label Text="{Binding QtdCriancas}" TextColor="{StaticResource Primary}" />
                        </HorizontalStackLayout>
                    </StackLayout>
                </Frame>

                <Frame Margin="10" BackgroundColor="{StaticResource PrimaryDark}">
                    <Grid ColumnDefinitions="*, *, *" RowDefinitions="Auto,  Auto">
                        <Label Grid.Row="0" Grid.Column="0" Text="Check-in:" />
                        <Label Grid.Row="0" Grid.Column="1" Text="Check-out:" />
                        <Label Grid.Row="0" Grid.Column="2" Text="Estadia:" />

                        <Label Grid.Row="1" Grid.Column="0" 
               Text="{Binding DataCheckIn, StringFormat='{}{0:dd/MM/yyyy}'}" 
               TextColor="{StaticResource Primary}"/>
                        <Label Grid.Row="1" Grid.Column="1" 
               Text="{Binding DataCheckOut, StringFormat='{}{0:dd/MM/yyyy}'}" 
               TextColor="{StaticResource Primary}"/>
                        <Label Grid.Row="1" Grid.Column="2" 
               Text="{Binding Estadia}" 
               TextColor="{StaticResource Primary}"/>
                    </Grid>
                </Frame>

                <Frame Margin="10" BackgroundColor="{StaticResource PrimaryDark}">
                    <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                        <Label Text="Valor Total: " />
                        <Label Text="{Binding ValorTotal, StringFormat='{}{0:c}'}" 
               TextColor="{StaticResource Primary}"/>
                    </HorizontalStackLayout>
                </Frame>

                <Button Text="Voltar" HorizontalOptions="Center" Clicked="Button_Clicked" />
            </VerticalStackLayout>
        </Frame>

    </VerticalStackLayout>
</ContentPage>